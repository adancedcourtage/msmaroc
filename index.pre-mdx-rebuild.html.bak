<!-- HERO -->
<section class="hero hero--fui">
  <canvas id="network-canvas" aria-hidden="true"></canvas>
  <div class="hero-fx" aria-hidden="true"><span class="hero-fx__scan"></span></div>
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <div class="eyebrow hero-in" style="--i:0">Agence digitale 360°</div>
        <h1>
          <span class="line-mask"><span class="word-mask"><span class="line-inner hero-in" style="--i:1">Un</span></span> <span class="word-mask"><span class="line-inner hero-in" style="--i:2">seul</span></span> <span class="word-mask"><span class="line-inner hero-in" style="--i:3">partenaire</span></span> <span class="word-mask"><span class="line-inner hero-in" style="--i:4">pour</span></span></span>
          <span class="line-mask"><span class="line-inner grad-text hero-in" style="--i:5" data-shimmer="brand" data-shimmer-base="#22d3ee">développer, digitaliser</span></span>
          <span class="line-mask"><span class="word-mask"><span class="line-inner hero-in" style="--i:6">et</span></span> <span class="word-mask"><span class="line-inner hero-in" style="--i:7">faire</span></span> <span class="word-mask"><span class="line-inner hero-in" style="--i:8">croître</span></span> <span class="word-mask"><span class="line-inner hero-in" style="--i:9">votre</span></span> <span class="word-mask"><span class="line-inner hero-in" style="--i:10">entreprise.</span></span></span>
        </h1>
        <p class="lead hero-in" style="--i:4">Sites web, automatisation &amp; IA, applications métier, communication, informatique, vidéosurveillance, électricité, consulting et formation : Marketing Success centralise toute votre transformation digitale.</p>
        <div class="hero-cta hero-in" style="--i:5">
          <a href="#contact" class="btn btn-primary" data-magnetic data-ripple><span class="mag-label">Demander un devis gratuit</span></a>
          <a href="#services" class="btn btn-ghost" data-magnetic data-ripple>Découvrir nos services</a>
        </div>
        <div class="hero-stats hero-in" style="--i:6">
          <div><b data-count="9">9</b><span>pôles d'expertise</span></div>
          <div><b data-count="200" data-suffix="+">200+</b><span>entreprises accompagnées</span></div>
          <div><b data-count="24" data-suffix="/7">24/7</b><span>support &amp; assistance</span></div>
        </div>
        <div class="hero-trust hero-in" style="--i:7">
          <div class="avatars"><span>SL</span><span>NB</span><span>YB</span><span>KM</span></div>
          <div class="rating">
            <span class="stars">★★★★★</span><b>4,9/5</b>
          </div>
          <div class="sep"></div>
          <small>Recommandé par nos clients au Maroc</small>
        </div>
      </div>
      <div class="hero-visual hero-in" style="--i:2" data-parallax="18">
        <div data-tilt data-tilt-max="7" data-tilt-scale="1.02">
          <video class="hero-video" autoplay loop muted playsinline poster="assets/sectors/ia.jpg" aria-label="Infrastructure et technologie Marketing Success">
            <source src="assets/video/hero-servers.mp4" type="video/mp4">
            <img src="assets/sectors/ia.jpg" alt="Infrastructure et technologie Marketing Success">
          </video>
          <div class="hero-badge"><b>200+</b> projets livrés</div>
        </div>
      </div>
    </div>
    <div id="hero-three" class="hero-three" aria-hidden="true"></div>
  </div>
</section>

